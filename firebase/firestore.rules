rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Robust admin check
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isModerator() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Checks if the request is trying to modify restricted fields
    function isNotModifying(fields) {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(fields));
    }

    function isFriend(uidA, uidB) {
      return exists(/databases/$(database)/documents/friendships/$(uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA));
    }

    function isBlocked(blocker, blocked) {
      return exists(/databases/$(database)/documents/blocks/$(blocker + '_' + blocked));
    }

    function isSafeProfileUpdate() {
      return isNotModifying([
        'xp', 'level', 'coins', 'badges', 'achievements', 'role',
        'accountStatus', 'createdAt', 'email', 'registrationOrder',
        'lastRankTransactionId', 'lastXpTransactionId',
        'proSessions', 'dailyProSessionsPlayed', 'lastProSessionDate'
      ]);
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTIONS
    // -------------------------------------------------------------------------

    // USERS: Profile and Progression (Game Identity)
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Allow creation for new users (Bootstrap)
      allow create: if isOwner(userId);

      // Restrict updates to safe fields only
      // Allows updating profile fields (avatar, bio, favoriteCategories) but protects progression stats
      // XP and Coins can only be updated if a corresponding transaction/settlement exists
      allow update: if isOwner(userId) &&
                    (
                      isSafeProfileUpdate() ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'proSessions', 'dailyProSessionsPlayed']) &&
                        (
                          // Authoritative Pro Mode Entry or Refund validation
                          // Allow progression updates (proSessions) without a transaction if coins are not modified (Free entry)
                          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']) ||
                           (request.resource.data.lastCoinTransactionId != null &&
                            existsAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastCoinTransactionId)) &&
                            getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastCoinTransactionId)).data.userId == request.auth.uid)) ||

                          // Legacy/Direct coin validation
                          (request.resource.data.lastCoinTransactionId != null &&
                           ((getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastCoinTransactionId)).data.direction == 'credit' &&
                             request.resource.data.coins == resource.data.coins + getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastCoinTransactionId)).data.amount) ||
                            (getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastCoinTransactionId)).data.direction == 'debit' &&
                             request.resource.data.coins == resource.data.coins - getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastCoinTransactionId)).data.amount)))
                        )
                      ) ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp']) &&
                        existsAfter(/databases/$(database)/documents/xp_transactions/$(request.resource.data.lastXpTransactionId))
                      )
                    );

      // Subcollections
      match /notifications/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /competitive_activity/{docId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (resource.data.visibility == 'public' && !isBlocked(userId, request.auth.uid)) ||
          (resource.data.visibility == 'friends' && isFriend(request.auth.uid, userId) && !isBlocked(userId, request.auth.uid))
        );
        allow create: if isOwner(userId) &&
                      request.resource.data.userId == userId &&
                      request.resource.data.id == docId &&
                      (
                        (request.resource.data.type == 'rankPromoted' && existsAfter(/databases/$(database)/documents/rank_transactions/$(request.resource.data.metadata.transactionId))) ||
                        (request.resource.data.type == 'achievementUnlocked' && existsAfter(/databases/$(database)/documents/users/$(userId)/achievements/$(request.resource.data.metadata.achievementId))) ||
                        (request.resource.data.type == 'milestoneCompleted' && existsAfter(/databases/$(database)/documents/users/$(userId)/milestones/$(request.resource.data.metadata.milestoneId))) ||
                        (request.resource.data.type == 'friendshipEstablished' && existsAfter(/databases/$(database)/documents/friendships/$(request.resource.data.metadata.friendshipId))) ||
                        !(request.resource.data.type in ['rankPromoted', 'achievementUnlocked', 'milestoneCompleted', 'friendshipEstablished'])
                      );
        allow update, delete: if isAdmin();
      }

      match /personal_records/{docId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /daily_engagement/{date} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                      request.resource.data.engagementDate == date &&
                      request.resource.data.playerId == userId &&
                      request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /milestones/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /achievements/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                      request.resource.data.achievementId == docId &&
                      request.resource.data.userId == userId &&
                      request.resource.data.status == 'unlocked';
        allow update: if false; // Unlocks are final
      }

      match /season_results/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /competitive_results/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /competitive_goals/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /competitive_stats/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /practice_results/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /game_results/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /session_summaries/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // IDENTITY: Personal information (Sync layers)
    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
                    isNotModifying(['email']);
      allow delete: if isAdmin();
    }

    match /user_game_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /user_preferences/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // PRESENCE: Real-time status
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // LEGACY: Support for older progression models if still in use
    match /players/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /player_progression/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /xp_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId) &&
                    request.resource.data.amount >= 0 &&
                    (
                      (request.resource.data.source == 'achievement' &&
                       request.resource.data.amount == get(/databases/$(database)/documents/achievement_definitions/$(request.resource.data.referenceId)).data.xpReward) ||
                      (request.resource.data.source == 'milestone' && request.resource.data.amount < 10000) ||
                      (request.resource.data.source == 'goal' && request.resource.data.amount < 5000) ||
                      (!(request.resource.data.source in ['achievement', 'milestone', 'goal']) && request.resource.data.amount < 5000)
                    );
    }

    match /rank_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId);
    }

    match /coin_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId);
    }

    match /rank_history/{docId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId) &&
                    existsAfter(/databases/$(database)/documents/rank_transactions/$(request.resource.data.referenceResultId + '_tx'));
      allow update: if isOwner(resource.data.userId) && isNotModifying(['changeId', 'userId', 'newRankPoints']);
    }

    match /rank_movement_history/{docId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // TOURNAMENTS & EVENTS
    match /tournaments/{tournamentId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /competitive_events/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /daily_challenges/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // SEASONS
    match /seasons/{seasonId} { allow read: if true; allow write: if isAdmin(); }

    // ANNOUNCEMENTS: Publicly readable
    match /announcements/{announcementId} { allow read: if true; allow write: if isModerator(); }

    // SYSTEM CONFIG: App settings and feature flags
    match /system_config/{configId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    match /achievement_definitions/{achId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CONTENT TAXONOMY
    match /categories/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    match /subcategories/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /topics/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // QUESTIONS
    match /questions/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // QUESTION PACKS
    match /question_packs/{packId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // SEASON REWARD GRANTS
    match /season_reward_grants/{grantId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    // PUBLIC PROFILES: Source for other players
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow update: if isOwner(userId) &&
                    isNotModifying([
                      'currentRank', 'rankTier', 'rankPoints', 'division',
                      'careerHighlights', 'schemaVersion'
                    ]);
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // USERNAME RESERVATION
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.username.lower() == username;
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.username.lower() == username;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // SOCIAL & CHALLENGES
    match /friendships/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.userIds;
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds;
    }

    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.senderId &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.senderId != request.resource.data.receiverId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.receiverId && request.resource.data.status in ['accepted', 'declined']) ||
        (request.auth.uid == resource.data.senderId && request.resource.data.status == 'cancelled')
      ) && isNotModifying(['senderId', 'receiverId', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.followerId;
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.blockerId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.blockerId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.blockerId;
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.challengerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.challengerId ||
        request.auth.uid == resource.data.challengedPlayerId ||
        isAdmin()
      );
    }

    match /versus_matches/{matchId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.playerAId ||
        request.auth.uid == resource.data.playerBId ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // GAMEPLAY SESSIONS
    match /practice_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    match /competitive_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());

      match /answers/{docId} {
        allow read, write: if isAuthenticated() && (get(/databases/$(database)/documents/competitive_sessions/$(sessionId)).data.uid == request.auth.uid || isAdmin());
      }

      match /checkpoints/{docId} {
        allow read, write: if isAuthenticated() && (get(/databases/$(database)/documents/competitive_sessions/$(sessionId)).data.uid == request.auth.uid || isAdmin());
      }
    }

    match /pro_reservations/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    match /pro_results/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.playerId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.playerId == request.auth.uid || isAdmin());
    }

    // MATCHMAKING POOL
    match /matchmaking_pool/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // ANALYTICS
    match /question_analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /question_performance/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // LEADERBOARDS
    match /leaderboard_global/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /leaderboard_seasons/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (docId.matches('.*_' + request.auth.uid) || isOwner(docId));
    }

    match /rank_movement_history/{eventId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ECONOMY & STORE
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) &&
                    (
                      isNotModifying(['coins', 'tokens', 'lifetimeCoinsEarned', 'lifetimeTokensEarned']) ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'tokens']) &&
                        request.resource.data.lastTransactionId != null &&
                        (
                          // Primary: Strict transaction matching
                          (getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastTransactionId)).data.direction == 'credit' &&
                           request.resource.data.coins == resource.data.coins + getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastTransactionId)).data.amount) ||
                          (getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastTransactionId)).data.direction == 'debit' &&
                           request.resource.data.coins == resource.data.coins - getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastTransactionId)).data.amount) ||
                          // Fallback: Allow composite updates (e.g. Pro Mode refund + spend) if a valid transaction is logged
                          (existsAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastTransactionId)) &&
                           getAfter(/databases/$(database)/documents/wallet_transactions/$(request.resource.data.lastTransactionId)).data.userId == request.auth.uid)
                        )
                      )
                    ) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false; // Immutable ledger
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId) &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.createdAt == request.time;
      allow update: if isAdmin(); // Authoritative fulfillment
      allow delete: if false;
    }

    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // SYSTEM METADATA
    match /metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && docId == 'system');
      // Note: In production, you'd want a more secure way to increment counters,
      // like a Cloud Function or a more specific rule for the transaction.
      // For now, allowing authenticated users to write to 'system' to enable the registration counter.
    }
  }
}
